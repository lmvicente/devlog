---
import type { CollectionEntry } from "astro:content";
import { slugify } from "../lib/ids";

interface Props {
  milestones: CollectionEntry<"entries">[];
}

const { milestones } = Astro.props;
---

{milestones.length > 0 && (
  <div class="-mx-2 overflow-x-auto px-2 pb-2">
    <ol class="mt-7 flex min-w-max items-start">
      {milestones.map((entry, index) => (
        <li class="flex items-start">
          <a
            href={`#${slugify(entry.id)}`}
            class="group flex w-32 flex-none flex-col items-center rounded-xl text-center focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500"
          >
            <span class="grid size-9 place-items-center rounded-full border-2 border-indigo-200 bg-indigo-50 text-sm font-semibold text-indigo-700 transition group-hover:border-indigo-600 group-hover:bg-indigo-600 group-hover:text-white dark:border-indigo-800 dark:bg-indigo-950 dark:text-indigo-300 dark:group-hover:border-indigo-500 dark:group-hover:bg-indigo-500 dark:group-hover:text-white">
              {index + 1}
            </span>
            <span class="mt-3 max-w-28 text-xs font-medium leading-4 text-slate-600 transition group-hover:text-indigo-600 dark:text-slate-400 dark:group-hover:text-indigo-400">
              {entry.data.title}
            </span>
            <span class="mt-1 text-[11px] text-slate-400 dark:text-slate-500">
              {entry.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric" })}
            </span>
          </a>

          {index < milestones.length - 1 && (
            <span class="mt-4 block h-px w-12 flex-none bg-gradient-to-r from-indigo-300 to-slate-200 dark:from-indigo-700 dark:to-slate-700"></span>
          )}
        </li>
      ))}
    </ol>
  </div>
)}