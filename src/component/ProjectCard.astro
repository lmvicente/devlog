---
const { title, startDate, techstack, description } = Astro.props;
---

<div class="border max-w-2xl rounded p-4 transition delay-75 duration-200 ease-in-out hover:-translate-y-1 cursor-pointer">
  <h2 class="font-bold">{title}</h2>
  <p class="text-gray-500">{startDate}</p>
  <p>{description}</p>
  <p>{techstack}</p>
</div>