---
import { render } from "astro:content";

const { entry } = Astro.props;
const { Content } = await render(entry);

const { title, date, milestone, tags } = entry.data;
---
<!-- self-contained, independently distributable content -->
<article id={entry.id.replaceAll("/", "-")} class={`scroll-mt-24 my-12 ${milestone ? "border-l-4 border-blue-500 pl-6" : ""}`}>
  {title && (
    <h3 class="text-2xl font-bold tracking-tight text-neutral-900 leading-snug">
      {title}
    </h3>
  )}

  <p class="text-sm text-neutral-400 mt-2 mb-6">
    {date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}
  </p>

  <div class="prose prose-neutral prose-lg max-w-none">
    <Content />
  </div>

  {tags?.length > 0 && (
    <div class="mt-8 pt-4 border-t border-neutral-100 flex flex-wrap gap-2">
      {tags.map((tag: any) => (
        <span class="text-xs text-neutral-500 bg-neutral-100 px-2 py-1 rounded-full">
          {tag}
        </span>
      ))}
    </div>
  )}
</article>


