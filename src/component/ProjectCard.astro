---
const { title, startDate, techstack, description } = Astro.props;
const technologies = techstack
  .split(",")
  .map((technology: string) => technology.trim())
  .filter(Boolean);
const formattedDate = new Intl.DateTimeFormat("en-US", {
  month: "short",
  year: "numeric",
}).format(startDate);
---

<article class="group flex h-full min-h-72 flex-col overflow-hidden rounded-3xl border border-slate-200/80 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-indigo-200 hover:shadow-xl hover:shadow-slate-200/60 sm:p-7 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-indigo-800 dark:hover:shadow-black/20">
  <div class="mb-8 flex items-start justify-between gap-4">
    <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">
      {formattedDate}
    </span>
    <span class="grid size-9 place-items-center rounded-full border border-slate-200 text-slate-400 transition group-hover:border-indigo-200 group-hover:bg-indigo-600 group-hover:text-white dark:border-slate-700 dark:group-hover:border-indigo-600">
      <svg class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M7 7h10v10"></path>
      </svg>
    </span>
  </div>

  <h2 class="max-w-md text-xl font-semibold tracking-tight text-slate-950 sm:text-2xl dark:text-white">
    {title}
  </h2>
  <p class="mt-3 flex-1 text-sm leading-6 text-slate-600 dark:text-slate-400">
    {description}
  </p>

  <div class="mt-7 flex flex-wrap gap-2 border-t border-slate-100 pt-5 dark:border-slate-800">
    {technologies.map((technology: string) => (
      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
        {technology}
      </span>
    ))}
  </div>
</article>