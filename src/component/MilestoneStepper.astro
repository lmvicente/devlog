---
import type { CollectionEntry } from "astro:content";
import { slugify } from "../lib/ids";

interface Props {
  milestones: CollectionEntry<"entries">[];
}

const { milestones } = Astro.props;
---

{milestones.length > 0 && (
  <ol class="flex items-start w-full py-4">
    {milestones.map((entry, index) => (
      <li class="contents">
        
          <a href={`#${slugify(entry.id)}`}
          class="flex flex-col items-center flex-none group"
        >
          <div class="w-7 h-7 rounded-full bg-blue-100 border-2 border-blue-500 flex items-center justify-center text-blue-700 text-sm font-medium transition-colors group-hover:bg-blue-500 group-hover:text-white">
            {index + 1}
          </div>
          <span class="text-xs text-neutral-500 mt-2 max-w-20 text-center leading-tight">
            {entry.data.title}
          </span>
        </a>

        {index < milestones.length - 1 && (
          <div class="flex-1 h-0.5 bg-neutral-200 mx-1 self-start mt-3.5" />
        )}
      </li>
    ))}
  </ol>
)}